{
  "name": "dsh-request-log",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin that records every LLM provider request/response, viewable per call in the web UI.",
  "author": "young1lin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/young1lin/dsh-request-log.git"
  },
  "homepage": "https://github.com/young1lin/dsh-request-log#readme",
  "bugs": "https://github.com/young1lin/dsh-request-log/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/client.js.map",
    "lib/client.d.ts",
    "lib/index.js",
    "lib/index.js.map",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown && node scripts/emit-client-dts.mjs",
    "prepublishOnly": "pnpm run build && pnpm pack --dry-run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "llm",
    "request",
    "response",
    "logging"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.11",
    "lightningcss": "^1.33.0",
    "oxlint": "1.76.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.9.0"
}
